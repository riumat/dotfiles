/* layout from the Purple official rofi theme, colors aligned with i3/polybar */

configuration {
  show-icons: true;
  display-drun: "";
  disable-history: false;
}

* {
  font: "GeistMono NF 11";

  clr-window: #161717e6;
  clr-bg: #16171700;
  clr-fg: #C5C8C6;
  clr-urgent-bg: #A54242;
  clr-urgent-fg: #161717;
  clr-active-bg: #87ffdf2e;
  clr-active-fg: #ffffff;
  clr-br: #87ffdf;

  px: 0.0625em;
  sm: 0.125em;
  md: 0.25em;
  lg: 0.5em;

  sz-icon: 0.85em;

  pd: 0.125em 0.5em;
  pd-lg: 0.25em 0.5em;
  mr: 0 1ch 0 0;

  background-color: @clr-bg;
  text-color: @clr-fg;
  border: 0;
  border-radius: 0;
  padding: 0;
}

window {
  
  padding: 0;
}

mainbox {
  children: [listview, message, inputbar];
}

message {
  background-color: @clr-urgent-bg;
  text-color: @clr-urgent-fg;
  padding: @md;
}

textbox {
  text-color: @clr-fg;
}

listview {
  background-color: @clr-window;
  border-color: @clr-br;
  border: @sm;
  border-radius: 0.5em;
  spacing: @sm;
  fixed-height: 0;
  scrollbar: false;
  margin: 0 0 1em 0;
}

element {
  border: 0;
  padding: @pd;
}

element-icon {
  padding: 0 0 0 0.25em;
  margin: @mr;
  size: @sz-icon;
}

element.normal.normal {
  background-color: @clr-bg;
  text-color: @clr-fg;
}

element.normal.urgent {
  background-color: @clr-urgent-bg;
  text-color: @clr-urgent-fg;
}

element.normal.active {
  background-color: @clr-active-bg;
  text-color: @clr-fg;
}

element.selected.normal {
  background-color: @clr-active-bg;
  text-color: @clr-active-fg;
}

element.selected.urgent {
  background-color: @clr-urgent-bg;
  text-color: @clr-urgent-fg;
}

element.selected.active {
  background-color: @clr-active-bg;
  text-color: @clr-active-fg;
}

element.alternate.normal {
  background-color: @clr-bg;
  text-color: @clr-fg;
}

element.alternate.urgent {
  background-color: @clr-urgent-bg;
  text-color: @clr-urgent-fg;
}

element.alternate.active {
  background-color: @clr-active-bg;
  text-color: @clr-active-fg;
}

button.selected {
  background-color: @clr-bg;
  text-color: @clr-fg;
}

inputbar {
  background-color: @clr-window;
  border-color: @clr-br;
  border: @sm;
  border-radius: 0.5em;
  text-color: @clr-fg;
  padding: @pd-lg;
}

inputbar {
  children:
    [ prompt,
    textbox-prompt-colon,
    entry,
    case-indicator];
}

textbox-prompt-colon {
  expand: false;
  str: "->";
  margin: @mr;
  text-color: @clr-fg;
}
